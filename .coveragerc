[run]
source = .
omit =
    # Not this deployable / not product code — no value in collecting
    src/mcp_server/*
    src/tests/mcp_server/*
    src/tests/agents/*
    src/**/__init__.py
    tests/e2e-test/*
    */venv/*
    */env/*
    */.venv/*
    */.pytest_cache/*
    */node_modules/*
    # Stale in-backend test tree (CI runs src/tests/backend, not this)
    tests/*
    # Separate deployable (Function App) — not part of the FastAPI app under test
    azure_functions/*

[report]
# The integration-heavy monolith family is excluded from the GATE NUMBER but
# still MEASURED at [run] time: line data stays in .coverage, so the behavior
# map (which routes/branches the suite actually exercises) is available on
# demand:
#   coverage report --include='v4/api/router.py' -m
# Debt is paid by extraction: pure logic moved out of router.py into small
# tested modules enters the gate number automatically.
omit =

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError

[paths]
source =
    src/backend
    */site-packages

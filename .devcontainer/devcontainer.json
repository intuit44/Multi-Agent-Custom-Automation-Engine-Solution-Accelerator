{
  "name": "Multi Agent Custom Automation Engine Solution Accelerator",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {
      "shellautocompletion": true,
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.vscode-github-actions",
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-docker",
        "ms-vscode.js-debug",
        "ms-vscode.vscode-node-azure-pack",
        "charliermarsh.ruff",
        "exiasr.hadolint",
        "kevinrose.vsc-python-indent",
        "mosapride.zenkaku",
        "ms-python.python",
        "njpwerner.autodocstring",
        "redhat.vscode-yaml",
        "shardulm94.trailing-spaces",
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one",
        "ms-vscode.azure-account",
        "amazonwebservices.amazon-q-vscode",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "ms-azure-load-testing.microsoft-testing",
        "ms-azuretools.vscode-azure-github-copilot",
        "ms-azuretools.vscode-azure-mcp-server",
        "ms-azuretools.vscode-azureappservice",
        "ms-azuretools.vscode-azurecontainerapps",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-azurestaticwebapps",
        "ms-azuretools.vscode-azurestorage",
        "ms-azuretools.vscode-azurevirtualmachines",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-cosmosdb",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-python.autopep8",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-vscode.azurecli",
        "teamsdevapp.vscode-ai-foundry",
        "adpyke.codesnap",
        "amazonwebservices.aws-toolkit-vscode",
        "anthropic.claude-code",
        "azurite.azurite",
        "christian-kohler.npm-intellisense",
        "donjayamanne.githistory",
        "dotjoshjohnson.xml",
        "eamodio.gitlens",
        "google.gemini-cli-vscode-ide-companion",
        "google.geminicodeassist",
        "gruntfuggly.todo-tree",
        "humao.rest-client",
        "kuscamara.yamllint-fix",
        "mark-wiemer.vscode-autohotkey-plus-plus",
        "mechatroner.rainbow-csv",
        "ms-azuretools.vscode-azurelogicapps",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-playwright.playwright",
        "ms-python.flake8",
        "ms-toolsai.vscode-ai",
        "ms-toolsai.vscode-ai-remote",
        "ms-windows-ai-studio.windows-ai-studio",
        "msjsdiag.vscode-react-native",
        "pflannery.vscode-versionlens",
        "plibither8.remove-comments",
        "visualstudioexptteam.vscodeintellicode-completions",
        "vscjava.migrate-java-to-azure",
        "ms-vscode.vscode-speech",
        "WolfiesHorizon.python-auto-venv",
        "ms-vscode.powershell"
      ]
    }
  },
  "forwardPorts": [3001, 8000, 9000, 16274, 16277, 6080],
  "portsAttributes": {
    "3001": { "label": "Frontend", "onAutoForward": "notify" },
    "8000": { "label": "Backend API", "onAutoForward": "notify" },
    "9000": { "label": "MCP Server", "onAutoForward": "notify" },
    "16274": { "label": "MCP Inspector UI", "onAutoForward": "notify" },
    "16277": { "label": "MCP Inspector Proxy", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash ./.devcontainer/setupEnv.sh",
  "containerEnv": {
    "DISPLAY": "dummy",
    "PYTHONUNBUFFERED": "True",
    "UV_LINK_MODE": "copy"
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "memory": "8gb"
  }
}
